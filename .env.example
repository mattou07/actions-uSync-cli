# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens should not be converted to underscores!

# Required inputs
# Must be https. Umbraco only issues tokens over HTTPS, so for a local site use
# its https URL (e.g. https://localhost:44324) and run with
# NODE_TLS_REJECT_UNAUTHORIZED=0 (local only, never in a workflow) because Node
# does not trust the ASP.NET dev certificate.
INPUT_SERVER=
# Must start with umbraco-back-office-
INPUT_CLIENT-ID=
INPUT_CLIENT-SECRET=

# Wait stage
INPUT_WAIT=true
INPUT_WAIT-TIMEOUT-MINUTES=10
INPUT_WAIT-FOR-STARTUP-IMPORT=true

# Import stage
INPUT_IMPORT=true
INPUT_FORCE=false
# Leave empty to use the site's default set
INPUT_SET=
INPUT_GROUP=all

# Report stage
INPUT_REPORT=true
INPUT_FAIL-ON-CHANGES=false

# Cache and index rebuilds
INPUT_REBUILD-CACHE=false
# Comma or newline separated index names, empty = off
INPUT_REBUILD-INDEXES=

# Export stage
INPUT_EXPORT=false
INPUT_EXPORT-CLEAN=false
INPUT_DOWNLOAD-EXPORT=false
INPUT_EXPORT-ARTIFACT-NAME=usync-export

# Connection check stage
INPUT_CHECK-CONNECTIONS=true
INPUT_FAIL-ON-CONNECTION-ERROR=false

# Timeouts
INPUT_TIMEOUT-MINUTES=30
INPUT_REQUEST-TIMEOUT-SECONDS=60

# GitHub Actions default environment variables. These are set for every run of a
# workflow and can be used in your actions. Setting the value here will override
# any value set by `npm run local-run`.
# https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables

# GITHUB_STEP_SUMMARY=""
# RUNNER_TEMP=""
# GITHUB_WORKSPACE=""
# RUNNER_DEBUG=""
